# At least ONE LLM provider is required for the lab itself.
# (Claude Code's own usage is separate and comes from your Claude plan.)

# Databricks (sponsor). Host looks like https://<workspace>.cloud.databricks.com
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# evroc Think (EU-hosted open models: Llama, Qwen, Mistral, gpt-oss, Kimi, Gemma) — OpenAI-compatible
EVROC_API_KEY=

# Optional extra providers for model-family diversity
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Hard cap on estimated LLM spend by the app, in USD
LLM_BUDGET_USD=20

# Used for polite API access (OpenAlex mailto, User-Agent)
CONTACT_EMAIL=

# Comma-separated providers to never call (e.g. codex_cli after hitting a spend cap). Cached calls still replay.
DISABLE_PROVIDERS=

# Optional: PhilPapers API credentials (JSON API, e.g. the category feed). They do NOT open OAI-PMH: see NOTES.md.
PHILPAPERS_API_ID=
PHILPAPERS_API_KEY=
